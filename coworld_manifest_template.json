{
  "$schema": "https://raw.githubusercontent.com/Metta-AI/metta/main/packages/coworld/src/coworld/coworld_manifest_schema.json",
  "tags": ["strategy", "real-time", "multiplayer"],
  "game": {
    "name": "planet_wars",
    "description": "A BitWorld strategy game where players conquer planets and launch ships across a tiny star map.",
    "owner": "treeform@softmax.com",
    "config_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens"
      ],
      "properties": {
        "tokens": {
          "description": "One connection token per player slot, indexed by slot.",
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 0
          },
          "default": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
          ]
        },
        "seed": {
          "description": "Random seed.",
          "type": "integer",
          "minimum": 0,
          "default": 108519
        },
        "planetCount": {
          "description": "Number of planets to place in the world.",
          "type": "integer",
          "minimum": 1,
          "maximum": 48,
          "default": 47
        },
        "maxTicks": {
          "description": "Maximum ticks per game, where 18000 is about five minutes at 60 Hz and 0 disables the tick limit.",
          "type": "integer",
          "minimum": 0,
          "default": 18000
        },
        "maxGames": {
          "description": "Maximum games before shutdown, where 0 means infinite.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "num_agents": {
          "description": "Player seat count used by hosted league seating.",
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "default": 8
        }
      }
    },
    "results_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names",
        "scores",
        "win",
        "planets",
        "ships"
      ],
      "properties": {
        "names": {
          "description": "One player name or address per player slot.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scores": {
          "description": "One strategy score per player slot.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "win": {
          "description": "One win flag per player slot.",
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "planets": {
          "description": "One owned planet count per player slot.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "ships": {
          "description": "One total owned ship count per player slot.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocols": {
      "player": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      },
      "global": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/sprite_v1.md"
      }
    },
    "docs": {
      "readme": {
        "type": "uri",
        "value": "https://github.com/Metta-AI/coworld-planet-wars/blob/main/README.md"
      },
      "pages": [
        {
          "id": "rules.md",
          "title": "rules.md",
          "content": {
            "type": "text",
            "value": "# Planet Wars Rules\n\nPlayers conquer planets and launch ships across a small star map. Neutral planets can be captured by sending enough ships. Owned planets grow more ships over time. A player wins when every remaining active planet and ship belongs to them. If the tick limit is reached first, the game ends with no winner."
          }
        },
        {
          "id": "play_planet_wars.md",
          "title": "play_planet_wars.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/coworld-planet-wars/blob/main/README.md"
          }
        },
        {
          "id": "reward.md",
          "title": "reward.md",
          "content": {
            "type": "uri",
            "value": "https://github.com/Metta-AI/bitworld/blob/master/docs/reward_v1.md"
          }
        }
      ]
    },
    "runnable": {
      "type": "game",
      "image": "{{GAME_IMAGE}}",
      "run": ["/bin/planet_wars"],
      "source_url": "https://github.com/Metta-AI/coworld-planet-wars/tree/master"
    }
  },
  "player": [
    {
      "id": "skurge",
      "type": "player",
      "name": "Skurge",
      "description": "Sprite-protocol Planet Wars attacker that learns its color and slowly pressures visible planets.",
      "image": "{{SKURGE_IMAGE}}",
      "run": ["/bin/skurge"],
      "source_url": "https://github.com/Metta-AI/coworld-planet-wars/tree/master/players/skurge"
    }
  ],
  "commissioner": [
    {
      "id": "default-commissioner",
      "name": "Default Commissioner",
      "type": "commissioner",
      "description": "Game-agnostic round-robin commissioner with mean-score rankings and hourly Planet Wars rounds.",
      "source_url": "https://github.com/Metta-AI/commissioners/tree/fa8ac7cb2bc6fd54c5675c7993919afabebcf4ba/commissioners/ruleset_strategy_commissioner",
      "image": "{{COMMISSIONER_IMAGE}}"
    }
  ],
  "reporter": [],
  "grader": [
    {
      "id": "bitworld-score-grader",
      "name": "BitWorld Score Grader",
      "type": "grader",
      "description": "Generic BitWorld grader that scores episode interest from score spread and game-specific activity signals.",
      "source_url": "https://github.com/Metta-AI/coworld-planet-wars/tree/master/grader/graders/bitworld_score/bitworld_score_grader",
      "image": "{{GRADER_IMAGE}}"
    }
  ],
  "variants": [
    {
      "id": "league",
      "name": "League",
      "game_config": {
        "seed": 108519,
        "planetCount": 47,
        "maxTicks": 18000,
        "maxGames": 1,
        "num_agents": 8
      },
      "description": "One bounded eight-seat Planet Wars match, used for hosted league rounds."
    },
    {
      "id": "smoke",
      "name": "Smoke",
      "game_config": {
        "seed": 108519,
        "planetCount": 47,
        "maxTicks": 1200,
        "maxGames": 1
      },
      "description": "Short deterministic Planet Wars configuration used for manifest checks."
    }
  ],
  "certification": {
    "game_config": {
      "seed": 108519,
      "planetCount": 47,
      "maxTicks": 1200,
      "maxGames": 1
    },
    "players": [
      {
        "player_id": "skurge"
      },
      {
        "player_id": "skurge"
      },
      {
        "player_id": "skurge"
      },
      {
        "player_id": "skurge"
      },
      {
        "player_id": "skurge"
      },
      {
        "player_id": "skurge"
      },
      {
        "player_id": "skurge"
      },
      {
        "player_id": "skurge"
      }
    ]
  }
}
